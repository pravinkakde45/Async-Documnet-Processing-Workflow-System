# ==============================================================================
# ENVIRONMENT VARIABLES BLUEPRINT (.env.example)
# Rename this file to '.env' and insert secure passwords/production hostnames.
# DO NOT commit the resulting '.env' file to your Git repository.
# ==============================================================================

# PostgreSQL Credentials (Update for live database services)
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=async_doc_proc
POSTGRES_PORT=5432

# Redis Configurations
REDIS_HOST=redis
REDIS_PORT=6379

# Shared Storage Directory
UPLOAD_DIR=/app/shared_data/uploads

# External Client Bindings (For production live hosting, replace localhost with your domain names)
VITE_API_URL=http://localhost:8001/api
VITE_WS_URL=ws://localhost:8001/api/ws
